{
  "name": "@local/aris-wiki",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Aris_Wiki：Web UI 侧栏只读看板，三个页签——计划（流水线状态/阻碍/阶段/门禁，与 Aris_Dsh 同源）、产物（论文图实验审查预览）、文档（一屏检索阅读 ARIS 知识资产）。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
