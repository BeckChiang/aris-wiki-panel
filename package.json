{
  "name": "@local/aris-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ARIS 知识库：在 Web UI 侧栏一屏检索与阅读本机的 ARIS 上游文档、替代矩阵、项目文献、笔记与检索日志（只读，不新建存储）。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
